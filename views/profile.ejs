<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>User Profile</title>
  </head>
  <body>
    <h1>Hello, <%= user.name %>!</h1>
    <img src="<%= user.profilePhoto %>" alt="Profile Photo" />
    <p>Email: <%= user.email %></p>
    <a href="/logout">Logout</a>
  </body>
</html>
